# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database
DATABASE_URL=postgresql://localhost:5432/nxflix

# Default LLM provider and model
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

# API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# Ollama (for local models)
OLLAMA_BASE_URL=http://localhost:11434

# Opik tracing
OPIK_ENABLED=true
OPIK_API_KEY=...
OPIK_PROJECT_NAME=nxflix-jlpt-n1
